# --- Connection ---
MSSQL_SERVER=yourserver.database.windows.net
MSSQL_PORT=1433
MSSQL_DATABASE=YourDatabase
MSSQL_ENCRYPT=yes
MSSQL_TRUST_SERVER_CERT=no

# --- Auth mode (see section 2 of the build spec) ---
#   sql                          - SQL login (dev only)
#   windows                      - Windows integrated auth
#   entra_service_principal      - App registration with client secret  [prod]
#   entra_service_principal_cert - App registration with certificate    [prod]
#   entra_managed_identity       - Azure managed identity               [prod, in-Azure]
#   entra_cli                    - Reuse az-login cached token          [dev w/ MFA]
#   entra_default                - DefaultAzureCredential chain         [just-works]
#   entra_interactive            - Browser popup + MFA, cached
#   entra_device_code            - Device code flow for headless hosts
MSSQL_AUTH_MODE=entra_default

# --- SQL / Windows auth (only used when MSSQL_AUTH_MODE=sql) ---
MSSQL_USERNAME=
MSSQL_PASSWORD=

# --- Entra ID ---
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_CLIENT_CERTIFICATE_PATH=
AZURE_CLIENT_CERTIFICATE_PASSWORD=
MSSQL_TOKEN_CACHE_PATH=~/.cache/mssql-mcp/token-cache.bin
MSSQL_DISABLE_TOKEN_CACHE=false

# --- Behavior ---
MSSQL_READ_ONLY=true
MSSQL_ALLOW_DDL=false
MSSQL_MAX_ROWS=1000
MSSQL_MAX_AFFECTED_ROWS=10000
MSSQL_QUERY_TIMEOUT=30
MSSQL_POOL_SIZE=5

# --- Server ---
MSSQL_AUDIT_LOG_PATH=./logs/audit.jsonl
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000
LOG_LEVEL=INFO
